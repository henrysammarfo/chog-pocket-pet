# Public settings only. Copy to .env.local. Never commit a real key.

# Monad read endpoint. Default is the public one.
NEXT_PUBLIC_MONAD_RPC_URL=https://rpc.monad.xyz

# $CHOG coin. Printed on https://chog.xyz/
NEXT_PUBLIC_CHOG_TOKEN_ADDRESS=0x350035555E10d9AfAF1566AaebfCeD5BA6C27777

# Chog picture collection. NOT printed on chog.xyz.
# Default is Chog Genesis, the collection whose pictures have traits.
# Change this if the Chog team names a different collection.
NEXT_PUBLIC_CHOG_NFT_ADDRESS=0xc96d31F8626c6D03Fae5dCD3d61e3FB9F4a73763

# Savings jar on Monad mainnet. Override only if you deploy another copy.
NEXT_PUBLIC_JAR_ADDRESS=0xf8Ae354fa05f315B81F2296D541021068CbbECde
